# Copy to .env for local development only. The preferred place for secrets is the
# macOS Keychain (run `jarvis key set anthropic_api_key`). `.env` is a fallback
# for the Anthropic API key and is never committed.
ANTHROPIC_API_KEY=

# Optional: override the project root used for config.toml, data/ and logs/.
# JARVIS_HOME=/path/to/jarvis
